# ==========================================
# CASHLYTICS BACKEND ENVIRONMENT TEMPLATE
# Production / Render deployment template
# ==========================================

# Server & Runtime
NODE_ENV=production
PORT=10000
LOG_LEVEL=info

# Database (MongoDB Atlas)
# In MongoDB Atlas Network Access, ensure 0.0.0.0/0 is whitelisted for Render
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cashlytics?retryWrites=true&w=majority

# Security & Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS & Frontend Origins (Comma-separated if multiple)
CLIENT_ORIGIN=https://your-frontend-app.onrender.com,http://localhost:8443

# Rate Limiting & Upload Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ==========================================================================
# ==========================================================================
# EMAIL DELIVERY — BREVO
# ==========================================================================
# Render free tier blocks outbound SMTP (ports 465 / 587).
# Brevo uses a plain HTTPS API so it works reliably on Render.
# Free plan: 300 emails/day, sends to arbitrary recipient addresses without a custom domain.
#
# Setup (5 minutes, completely free):
#   1. Sign up at https://www.brevo.com (use your Gmail)
#   2. Dashboard → Settings → Senders & IP → Add a sender
#      Add cashlytics.ai@gmail.com and verify via the email sent to that address.
#   3. Dashboard → SMTP & API → API Keys tab → Generate a new API key (v3)
#      (Note: API keys start with 'xkeysib-'. Do NOT use the SMTP key starting with 'xsmtpsib-').
# ==========================================================================
BREVO_API_KEY=xkeysib-your-brevo-api-v3-key-here
BREVO_FROM_EMAIL=cashlytics.ai@gmail.com
BREVO_FROM_NAME=Cashlytics

# Google OAuth 2.0 (Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-app.onrender.com/api/auth/google/callback

# AI Assistant & Providers
# Options: 'auto' (tries local Ollama first, falls back to Groq), 'ollama', or 'groq' (for production)
AI_PROVIDER=groq
ML_SERVICE_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Groq Cloud API (Recommended for production on Render)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Admin Provisioning
ADMIN_EMAIL=admin@cashlytics.com
